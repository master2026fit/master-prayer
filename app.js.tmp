
const dailyPrayers = [
  {title:'오늘 하루를 맡기는 기도', text:'하나님, 오늘 하루도 주셔서 감사합니다.\n제가 서두르기보다 주님의 뜻을 먼저 생각하게 해주세요.\n제가 만나는 사람에게 따뜻한 말을 건네고, 해야 할 일을 성실히 감당하게 해주세요.\n걱정되는 일은 주님께 맡기고, 감사할 일을 놓치지 않게 해주세요.\n오늘도 제 마음과 생각과 행동을 바르게 이끌어주세요. 아멘.'},
  {title:'감사로 시작하는 기도', text:'하나님, 오늘 눈을 뜨고 새로운 하루를 맞게 해주셔서 감사합니다.\n당연하게 지나쳤던 작은 것들까지 감사하게 해주세요.\n불평보다 감사가 먼저 나오고, 부족함보다 받은 은혜를 먼저 보게 해주세요.\n오늘 제 마음에 평안을 주시고 감사하는 마음으로 살아가게 해주세요. 아멘.'},
  {title:'걱정을 내려놓는 기도', text:'하나님, 제 마음속 걱정과 두려움을 주님께 내려놓습니다.\n제가 해결할 수 없는 일을 붙잡고 불안해하지 않게 해주세요.\n해야 할 일은 담대하게 하고, 기다려야 할 일은 믿음으로 기다리게 해주세요.\n제 생각보다 크신 주님을 믿고 오늘 한 걸음씩 살아가게 해주세요. 아멘.'},
  {title:'가족을 위한 기도', text:'하나님, 제 가족을 지켜주시고 서로를 더 이해하고 사랑하게 해주세요.\n각자의 자리에서 건강하고 평안하게 하시며 어려움이 있을 때 서로에게 힘이 되게 해주세요.\n말로 상처 주기보다 격려하고, 당연하게 여기기보다 감사하게 해주세요.\n우리 가정에 사랑과 평화를 더해주세요. 아멘.'},
  {title:'지혜를 구하는 기도', text:'하나님, 오늘 제가 해야 할 선택 앞에서 지혜를 주세요.\n감정에 끌려가지 않고 무엇이 옳은지 차분히 분별하게 해주세요.\n말해야 할 때와 침묵해야 할 때를 알게 하시고, 욕심보다 바른 길을 선택하게 해주세요.\n오늘의 결정이 좋은 열매로 이어지게 해주세요. 아멘.'},
  {title:'힘이 필요할 때의 기도', text:'하나님, 오늘 제 힘만으로 버겁게 느껴지는 일을 주님께 맡깁니다.\n지친 마음을 붙들어주시고 포기하지 않을 힘을 주세요.\n한꺼번에 모든 것을 해결하려 하지 않고 지금 할 수 있는 한 가지를 해나가게 해주세요.\n제 곁에 함께하시는 주님을 믿고 다시 힘을 내게 해주세요. 아멘.'},
  {title:'사랑을 실천하는 기도', text:'하나님, 오늘 제 말과 행동에 사랑을 담게 해주세요.\n내 생각만 고집하기보다 다른 사람의 마음을 먼저 살피게 해주세요.\n작은 친절을 미루지 않고, 용서해야 할 사람을 품을 수 있는 마음을 주세요.\n오늘 제가 있는 자리에서 주님의 사랑을 조금이라도 나타내게 해주세요. 아멘.'}
];

const categories = [
  {icon:'🌅',name:'아침', text:'하나님, 새로운 하루를 허락해주셔서 감사합니다. 오늘 제 생각과 말과 행동을 지켜주시고, 해야 할 일을 성실히 감당하게 해주세요. 작은 일에도 감사하며 주님과 함께 걷는 하루가 되게 해주세요. 아멘.'},
  {icon:'🍚',name:'식사', text:'하나님, 오늘도 먹을 것을 주시고 이 자리에 함께하게 해주셔서 감사합니다. 이 음식을 통해 건강과 힘을 얻게 하시고, 받은 것에 감사하며 나눌 줄 아는 마음도 주세요. 아멘.'},
  {icon:'💛',name:'감사', text:'하나님, 제 삶에 이미 주신 것들을 떠올려 봅니다. 당연하게 여겼던 사람과 건강과 일상까지 감사합니다. 오늘은 불평보다 감사를 더 많이 말하게 해주세요. 아멘.'},
  {icon:'👨‍👩‍👧‍👦',name:'가족', text:'하나님, 제 가족 한 사람 한 사람을 지켜주세요. 건강과 평안을 주시고 서로 이해하고 격려하게 해주세요. 힘든 일이 있을 때 함께 이겨내고 사랑이 더 깊어지는 가정이 되게 해주세요. 아멘.'},
  {icon:'😔',name:'힘들 때', text:'하나님, 지금 제 마음이 힘들고 지쳐 있습니다. 제 마음을 아시는 주님께 모든 것을 내려놓습니다. 견딜 힘과 지혜를 주시고, 이 시간이 지나갈 때까지 제 마음을 붙들어주세요. 아멘.'},
  {icon:'🌧️',name:'걱정될 때', text:'하나님, 머릿속을 떠나지 않는 걱정을 주님께 맡깁니다. 제가 할 수 있는 일과 할 수 없는 일을 분별하게 해주시고, 오늘 해야 할 한 걸음에 집중하게 해주세요. 제 마음에 평안을 주세요. 아멘.'},
  {icon:'⛪',name:'교회 가기 전', text:'하나님, 예배의 자리로 나아갑니다. 분주한 생각을 내려놓고 마음을 주님께 향하게 해주세요. 말씀을 잘 듣고 제 삶에 적용할 한 가지를 발견하게 해주세요. 감사와 기쁨으로 예배드리게 해주세요. 아멘.'},
  {icon:'🌙',name:'잠들기 전', text:'하나님, 오늘 하루도 지켜주셔서 감사합니다. 잘한 일은 감사하고 부족했던 일은 돌아봅니다. 걱정은 주님께 맡기고 편안히 쉬게 해주세요. 내일도 새로운 마음으로 시작하게 해주세요. 아멘.'}
];

let trainingStep=1, sentenceIndex=0, miniInterval=null, timerInterval=null;
let calendarCursor = new Date();

function pad(n){return String(n).padStart(2,'0')}
function localDateKey(d=new Date()){return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`}
function formatToday(){const d=new Date(); return `${d.getFullYear()}년 ${d.getMonth()+1}월 ${d.getDate()}일 ${['일','월','화','수','목','금','토'][d.getDay()]}요일`}
function dailyIndex(){const d=new Date(); const start=new Date(d.getFullYear(),0,0); const diff=d-start; const day=Math.floor(diff/86400000); return day % dailyPrayers.length}

function renderDaily(){
  const p=dailyPrayers[dailyIndex()];
  document.getElementById('dailyTitle').textContent=p.title;
  document.getElementById('dailyPrayer').textContent=p.text;
  document.getElementById('trainPrayer').textContent=p.text;
  sentenceIndex=0; renderSentence();
}
function renderCategories(){
  const html=categories.map((c,i)=>`<button class="tile" onclick="openCategory(${i})"><span>${c.icon}</span><strong>${c.name}</strong></button>`).join('');
  document.getElementById('allCategories').innerHTML=html;
  document.getElementById('homeCategories').innerHTML=categories.slice(0,4).map((c,i)=>`<button class="tile" onclick="openCategory(${i})"><span>${c.icon}</span><strong>${c.name}</strong></button>`).join('');
}
function openCategory(i){
  const c=categories[i];
  document.getElementById('modalTitle').textContent=`${c.icon} ${c.name} 기도`;
  document.getElementById('modalBody').innerHTML=`<div class="prayer">${c.text}</div><button class="btn good full" style="margin-top:14px" onclick="markTodayDone();closeModal()">기도 완료 ✓</button>`;
  document.getElementById('modal').classList.add('show');
}
function closeModal(){document.getElementById('modal').classList.remove('show');clearInterval(timerInterval)}
function showView(id,btn){
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('nav button').forEach(b=>b.classList.remove('active'));
  if(btn) btn.classList.add('active');
  if(id==='calendarView') renderCalendar();
  if(id==='myprayer') renderMyPrayers();
  window.scrollTo({top:0,behavior:'smooth'});
}
function startTraining(){
  const btn=[...document.querySelectorAll('nav button')].find(b=>b.dataset.view==='training');
  showView('training',btn); setTrainingStep(1);
}
function setTrainingStep(n){
  trainingStep=Math.max(1,Math.min(4,n));
  document.querySelectorAll('.step').forEach(s=>s.classList.toggle('active',Number(s.dataset.step)===trainingStep));
  document.getElementById('progressBar').style.width=`${trainingStep*25}%`;
  document.getElementById('nextStepBtn').textContent=trainingStep===4?'완료':'다음';
}
function nextStep(){
  if(trainingStep<4) setTrainingStep(trainingStep+1);
  else {markTodayDone(); const btn=[...document.querySelectorAll('nav button')].find(b=>b.dataset.view==='home'); showView('home',btn);}
}
function prevStep(){if(trainingStep>1)setTrainingStep(trainingStep-1)}
function renderSentence(){
  const text=dailyPrayers[dailyIndex()].text.replace(/\n/g,' ');
  const sentences=text.split(/(?<=[.!?]|아멘\.)\s+/).filter(Boolean);
  if(sentenceIndex>=sentences.length) sentenceIndex=0;
  document.getElementById('trainSentence').textContent=sentences[sentenceIndex] || text;
}
function nextSentence(){
  const text=dailyPrayers[dailyIndex()].text.replace(/\n/g,' ');
  const sentences=text.split(/(?<=[.!?]|아멘\.)\s+/).filter(Boolean);
  sentenceIndex++;
  if(sentenceIndex>=sentences.length){sentenceIndex=0; setTrainingStep(3)} else renderSentence();
}
function startMiniTimer(){
  clearInterval(miniInterval); let sec=60;
  const el=document.getElementById('miniTimer'); el.textContent='01:00';
  miniInterval=setInterval(()=>{sec--;el.textContent=`00:${pad(sec)}`; if(sec<=0){clearInterval(miniInterval);el.textContent='완료 ✓';}},1000);
}
function openTimer(minutes){
  clearInterval(timerInterval); let sec=minutes*60;
  document.getElementById('modalTitle').textContent=`🙏 ${minutes}분 자유기도`;
  document.getElementById('modalBody').innerHTML=`<div class="prompt">지금 마음에 가장 먼저 떠오르는 것부터 하나님께 말씀드려봐.</div><div class="timer" id="bigTimer">${pad(minutes)}:00</div><div class="small" style="text-align:center">말이 멈춰도 괜찮아. 잠시 조용히 머물러도 돼.</div>`;
  document.getElementById('modal').classList.add('show');
  timerInterval=setInterval(()=>{sec--; const m=Math.floor(sec/60),s=sec%60; const el=document.getElementById('bigTimer'); if(el)el.textContent=`${pad(m)}:${pad(s)}`; if(sec<=0){clearInterval(timerInterval);if(el)el.textContent='완료 ✓';markTodayDone(false)}},1000);
}
function getData(){
  return {done:JSON.parse(localStorage.getItem('prayerDone')||'[]'), prayers:JSON.parse(localStorage.getItem('myPrayers')||'[]')};
}
function markTodayDone(show=true){
  const data=getData(); const k=localDateKey(); if(!data.done.includes(k)){data.done.push(k);localStorage.setItem('prayerDone',JSON.stringify(data.done));}
  if(show){
    document.getElementById('modalTitle').textContent='오늘 기도 완료 ✓';
    document.getElementById('modalBody').innerHTML='<div class="quote">잘했어. 길게 하지 않아도 매일 하나님께 마음을 드리는 시간이 쌓이는 게 중요해.</div>';
    document.getElementById('modal').classList.add('show');
  }
  renderCalendar();
}
function saveMyPrayer(){
  const title=document.getElementById('myTitle').value.trim();
  const body=document.getElementById('myBody').value.trim();
  if(!body){alert('기도 내용을 적어줘.');return}
  const list=JSON.parse(localStorage.getItem('myPrayers')||'[]');
  list.unshift({id:Date.now(),title:title||'나의 기도',body,date:localDateKey()});
  localStorage.setItem('myPrayers',JSON.stringify(list));
  document.getElementById('myTitle').value=''; document.getElementById('myBody').value=''; renderMyPrayers();
}
function renderMyPrayers(){
  const list=JSON.parse(localStorage.getItem('myPrayers')||'[]');
  const el=document.getElementById('myPrayerList');
  if(!list.length){el.innerHTML='<div class="card hint">아직 저장한 기도가 없어. 오늘 마음에 있는 말부터 한 줄 적어봐.</div>';return}
  el.innerHTML=list.map(p=>`<div class="saved"><div class="meta">${p.date}</div><strong>${escapeHtml(p.title)}</strong><div class="body">${escapeHtml(p.body)}</div><div class="actions"><button onclick="openSaved(${p.id})">크게 보기</button><button onclick="deletePrayer(${p.id})">삭제</button></div></div>`).join('');
}
function escapeHtml(s){return String(s).replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]))}
function openSaved(id){const p=JSON.parse(localStorage.getItem('myPrayers')||'[]').find(x=>x.id===id);if(!p)return;document.getElementById('modalTitle').textContent=p.title;document.getElementById('modalBody').innerHTML=`<div class="prayer">${escapeHtml(p.body)}</div>`;document.getElementById('modal').classList.add('show')}
function deletePrayer(id){if(!confirm('이 기도문을 삭제할까?'))return;const list=JSON.parse(localStorage.getItem('myPrayers')||'[]').filter(p=>p.id!==id);localStorage.setItem('myPrayers',JSON.stringify(list));renderMyPrayers()}

function changeMonth(delta){calendarCursor=new Date(calendarCursor.getFullYear(),calendarCursor.getMonth()+delta,1);renderCalendar()}
function renderCalendar(){
  const y=calendarCursor.getFullYear(),m=calendarCursor.getMonth();
  const first=new Date(y,m,1), last=new Date(y,m+1,0);
  const done=getData().done;
  document.getElementById('monthLabel').textContent=`${y}년 ${m+1}월`;
  const dows=['일','월','화','수','목','금','토'].map(x=>`<div class="dow">${x}</div>`).join('');
  let cells=''; for(let i=0;i<first.getDay();i++)cells+='<div class="day empty"></div>';
  let monthCount=0;
  for(let day=1;day<=last.getDate();day++){
    const d=new Date(y,m,day);const k=localDateKey(d);const isDone=done.includes(k);if(isDone)monthCount++;
    const today=k===localDateKey();cells+=`<div class="day ${isDone?'done':''} ${today?'today':''}">${day}${isDone?' ✓':''}</div>`;
  }
  document.getElementById('calendar').innerHTML=dows+cells;
  document.getElementById('monthCount').textContent=monthCount;
  document.getElementById('streakCount').textContent=calcStreak(done);
}
function calcStreak(done){
  const set=new Set(done); let d=new Date(); let count=0;
  if(!set.has(localDateKey(d))){d.setDate(d.getDate()-1)}
  while(set.has(localDateKey(d))){count++;d.setDate(d.getDate()-1)}
  return count;
}
function exportBackup(){
  const payload={version:1,exportedAt:new Date().toISOString(),...getData()};
  const blob=new Blob([JSON.stringify(payload,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`today-prayer-backup-${localDateKey()}.json`;a.click();URL.revokeObjectURL(a.href)
}
function importBackup(ev){
  const file=ev.target.files[0];if(!file)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);if(Array.isArray(d.done))localStorage.setItem('prayerDone',JSON.stringify(d.done));if(Array.isArray(d.prayers))localStorage.setItem('myPrayers',JSON.stringify(d.prayers));renderMyPrayers();renderCalendar();alert('백업을 불러왔어.')}catch(e){alert('백업 파일을 확인해줘.')}};r.readAsText(file)
}

document.getElementById('todayLabel').textContent=formatToday();
renderDaily();renderCategories();renderMyPrayers();renderCalendar();
if('serviceWorker' in navigator){window.addEventListener('load',()=>navigator.serviceWorker.register('./sw.js').catch(()=>{}))}
